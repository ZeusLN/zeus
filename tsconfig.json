{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "isolatedModules": false,
    "jsx": "react-native",
    "lib": ["es6"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "target": "esnext",
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "*" : ["typings/*"],
      "@react-navigation/bottom-tabs/unstable": [
        "node_modules/@react-navigation/bottom-tabs/lib/typescript/src/unstable/index.d.ts"
      ]
    }
  },
  "exclude": ["node_modules", "zeus_modules", "android", "ios"],
  "include": ["**/*.ts", "**/*.tsx"]
}
