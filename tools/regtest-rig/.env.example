# tools/regtest-rig configuration. Copy to .env (default) or to any file and point
# RIG_ENV at it to run a second rig side by side:
#   RIG_ENV=$PWD/rig2.env bin/up
# Every value here is optional; env.sh fills in the defaults shown.

# Compose project name, container prefix and state/<RIG_NAME>/ directory.
RIG_NAME=zrig

# All host ports are PORT_BASE + a fixed offset unless set individually.
# A second rig only needs a different RIG_NAME, PORT_BASE, AVD_NAME,
# ADB_SERVER_PORT and EMU_PORT.
PORT_BASE=24600

# bitcoind
#BTC_RPC_PORT=24601        # PORT_BASE+1
#BTC_P2P_PORT=24602        # PORT_BASE+2 (neutrino for embedded LND)

# lnd nodes (REST, gRPC, p2p)
#ALICE_REST_PORT=24610
#ALICE_GRPC_PORT=24611
#ALICE_P2P_PORT=24612
#BOB_REST_PORT=24620
#BOB_GRPC_PORT=24621
#BOB_P2P_PORT=24622        # LDK Node on the emulator peers with bob at 10.0.2.2:<this>
#CAROL_REST_PORT=24630
#CAROL_GRPC_PORT=24631
#CAROL_P2P_PORT=24632

# Optional services
#ESPLORA_PORT=24640        # electrs HTTP (profile ldk)
#ELECTRUM_PORT=24641       # electrs electrum RPC (profile ldk)
#MINT_PORT=24650           # cdk-mintd fakewallet (profile cashu)
#RELAY_PORT=24660          # nostr-rs-relay (profile nwc)
#LSP_PORT=24670            # stub Olympus Flow LSP, host process (profile lsp)
#LNURL_PORT=24680          # LNURL-withdraw server, host process
#METRO_PORT=24690          # Metro; the app always sees it as localhost:8081

# fakewallet payment delay in seconds (when a mint quote turns PAID)
#MINT_MIN_DELAY=1
#MINT_MAX_DELAY=3

# Android: private adb server and emulator console port (even number)
ADB_SERVER_PORT=5137
EMU_PORT=5640           # even, above 5585 (outside adb's scan range)
AVD_NAME=zrig
#AVD_IMAGE="system-images;android-35;google_apis;arm64-v8a"
#AVD_DEVICE=pixel_7

# Zeus checkout or worktree Metro serves (needs node_modules). Defaults to
# the checkout this rig lives in.
#ZEUS_DIR=/path/to/zeus-worktree
# APK bin/app install uses when no path is given
#APK=/path/to/app-arm64-v8a-debug.apk

# Compose profiles bin/up enables: any of lsp,cashu,nwc,ldk (or "all")
PROFILES=
